# Required for local API authentication; generate a unique random value.
DEMO_TOKEN=replace-with-a-long-random-token

# Optional: set an OpenAI API key with available API credits to enable live voice.
# Leave blank to use only the simulated local tool-flow buttons.
OPENAI_API_KEY=

# Optional; must be available to the API project used by OPENAI_API_KEY.
REALTIME_MODEL=gpt-realtime-2.1
